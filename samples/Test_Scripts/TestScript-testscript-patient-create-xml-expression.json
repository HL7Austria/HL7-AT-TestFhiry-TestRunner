{
  "resourceType": "TestScript",
  "id": "testscript-patient-create-xml-expression",
  "url": "http://hl7.at/fhir/HL7ATCoreProfiles/4.0.1/TestScript/testscript-patient-create-xml-expression",
  "version": "1.0.0",
  "name": "HL7 AT Core TestScript - Patient Create XML with Expression",
  "title": "HL7 AT Core TestScript - Patient Create XML with Expression",
  "status": "active",
  "date": "2026-06-05",
  "publisher": "HL7 Austria",
  "description": "TestScript creating a patient resource with XML format and testing FHIRPath expression on XML response.",
  "origin": [{
    "index": 1,
    "profile": {
      "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types",
      "code": "FHIR-Client"
    }
  }],
  "destination": [{
    "index": 1,
    "profile": {
      "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types",
      "code": "FHIR-Server"
    }
  }],
  "fixture": [{
    "id": "patient-create-xml",
    "autocreate": false,
    "autodelete": false,
    "resource": {
      "reference": "Patient-HL7ATCorePatientCreateTestExampleXML.xml"
    }
  }],
  "test": [{
    "id": "Step1-CreatePatientXML",
    "name": "CreatePatientXML",
    "description": "Create a new patient using XML format and test FHIRPath expression on response.",
    "action": [{
      "operation": {
        "type": {
          "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
          "code": "create"
        },
        "resource": "Patient",
        "description": "Create patient with XML format.",
        "accept": "xml",
        "contentType": "xml",
        "destination": 1,
        "encodeRequestUrl": true,
        "origin": 1,
        "responseId": "create-response-xml",
        "sourceId": "patient-create-xml"
      }
    },
    {
      "assert": {
        "description": "Confirm that the returned HTTP status is 200(OK) or 201(Created).",
        "direction": "response",
        "operator": "in",
        "responseCode": "200,201",
        "warningOnly": false
      }
    },
    {
      "assert": {
        "description": "Test FHIRPath expression on XML response - check family name.",
        "direction": "response",
        "expression": "Patient.name.family",
        "operator": "equals",
        "value": "Wolfesberger",
        "warningOnly": false
      }
    }]
  }]
}
