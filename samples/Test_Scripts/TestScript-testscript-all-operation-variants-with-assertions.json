{
  "resourceType": "TestScript",
  "id": "testscript-all-operation-variants-with-assertions",
  "url": "http://hl7.at/fhir/TestScript/testscript-all-operation-variants-with-assertions",
  "version": "1.0",
  "name": "TestScriptAllOperationVariantsWithAssertions",
  "title": "TestScript - All Standard Operation Variants With Supported Assertions",
  "status": "draft",
  "experimental": true,
  "date": "2025-05-12",
  "publisher": "HL7 Austria",
  "description": "Comprehensive TestScript covering every standard FHIR operation variant (create, read, vread, update, patch, delete-by-id, conditional-delete, search-GET, history-instance, history-type, capabilities, batch, transaction) with all supported assertion types (responseCode, response, contentType, headerField, expression) except validateProfileId. Fixtures reference existing Example_Instances.",
  "origin": [
    {
      "index": 1,
      "profile": {
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-origin-types",
        "code": "FHIR-Client"
      }
    }
  ],
  "destination": [
    {
      "index": 1,
      "profile": {
        "system": "http://terminology.hl7.org/CodeSystem/testscript-profile-destination-types",
        "code": "FHIR-Server"
      }
    }
  ],
  "fixture": [
    {
      "id": "patient-create",
      "autocreate": true,
      "autodelete": false,
      "resource": {
        "reference": "Patient-HL7ATCorePatientCreateTestExample.html"
      }
    },
    {
      "id": "patient-update",
      "autocreate": true,
      "autodelete": false,
      "resource": {
        "reference": "Patient-HL7ATCorePatientUpdateTestExample.html"
      }
    },
    {
      "id": "organization-create",
      "autocreate": true,
      "autodelete": false,
      "resource": {
        "reference": "Organization-Organization-example-f001-burgers.html"
      }
    },
    {
      "id": "patient-deceased",
      "autocreate": true,
      "autodelete": false,
      "resource": {
        "reference": "Patient-HL7ATCorePatientExample03-deceasedBoolean.html"
      }
    },
    {
      "id": "json-patch-patient",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "JSONPatch-Patient-active-false.html"
      }
    },
    {
      "id": "batch-bundle-patient",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "Bundle-batch-create-patient.html"
      }
    },
    {
      "id": "transaction-bundle-organization",
      "autocreate": false,
      "autodelete": false,
      "resource": {
        "reference": "Bundle-transaction-create-organization.html"
      }
    }
  ],
  "variable": [
    {
      "name": "patientId",
      "expression": "Patient.id",
      "sourceId": "create-response"
    },
    {
      "name": "patientVersionId",
      "headerField": "ETag",
      "sourceId": "read-response"
    }
  ],
  "setup": {
    "action": [
      {
        "operation": {
          "type": {
            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
            "code": "delete"
          },
          "resource": "Patient",
          "description": "Setup: Conditional delete to clean up any existing test patient.",
          "accept": "json",
          "contentType": "json",
          "encodeRequestUrl": true,
          "params": "?family=Bucher&given=Andreas"
        }
      },
      {
        "operation": {
          "type": {
            "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
            "code": "delete"
          },
          "resource": "Organization",
          "description": "Setup: Conditional delete to clean up any existing test organization.",
          "accept": "json",
          "contentType": "json",
          "encodeRequestUrl": true,
          "params": "?name=Burgers%20University%20Medical%20Center"
        }
      }
    ]
  },
  "test": [
    {
      "id": "Test01-Create",
      "name": "Create Operation (POST)",
      "description": "Create a Patient resource using the create operation (POST). Expects HTTP 201.",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "create"
            },
            "resource": "Patient",
            "description": "Create a new Patient resource on the server.",
            "accept": "json",
            "contentType": "json",
            "encodeRequestUrl": true,
            "responseId": "create-response",
            "sourceId": "patient-create"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is 201 (Created).",
            "direction": "response",
            "responseCode": "201",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the response display is 'created'.",
            "direction": "response",
            "response": "created",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the response content type contains JSON.",
            "contentType": "application/fhir+json",
            "warningOnly": false
          }
        }
      ]
    },
    {
      "id": "Test02-Read",
      "name": "Read Operation (GET by id)",
      "description": "Read the created Patient resource using the read operation (GET /Patient/[id]).",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "read"
            },
            "resource": "Patient",
            "description": "Read the Patient created in Test01 by targetId.",
            "accept": "json",
            "encodeRequestUrl": true,
            "responseId": "read-response",
            "targetId": "create-response"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is 200 (OK).",
            "direction": "response",
            "responseCode": "200",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the response display is 'okay'.",
            "direction": "response",
            "response": "okay",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the response content type contains JSON.",
            "contentType": "application/fhir+json",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the returned resource is a Patient.",
            "expression": "Patient.resourceType = 'Patient'",
            "operator": "eval",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the returned Patient has a family name of 'Bucher'.",
            "expression": "Patient.name.where(family = 'Bucher').exists()",
            "operator": "eval",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the Location header is present.",
            "headerField": "Content-Type",
            "operator": "notEmpty",
            "warningOnly": false
          }
        }
      ]
    },
    {
      "id": "Test03-VRead",
      "name": "VRead Operation (GET by id and versionId)",
      "description": "Version-read the Patient resource using vread (GET /Patient/[id]/_history/[vid]).",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "vread"
            },
            "resource": "Patient",
            "description": "VRead the Patient using id and versionId from the read response.",
            "accept": "json",
            "encodeRequestUrl": true,
            "responseId": "vread-response",
            "targetId": "read-response"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is 200 (OK).",
            "direction": "response",
            "responseCode": "200",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the response display is 'okay'.",
            "direction": "response",
            "response": "okay",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the returned resource is a Patient.",
            "expression": "Patient.resourceType = 'Patient'",
            "operator": "eval",
            "warningOnly": false
          }
        }
      ]
    },
    {
      "id": "Test04-Update",
