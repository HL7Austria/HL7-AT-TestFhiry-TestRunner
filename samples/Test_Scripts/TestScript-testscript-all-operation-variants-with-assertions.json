        {
          "assert": {
            "description": "Confirm the returned Bundle contains at least one entry.",
            "expression": "Bundle.entry.count() > 0",
            "operator": "eval",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the returned resource is a Bundle.",
            "expression": "Bundle.resourceType = 'Bundle'",
            "operator": "eval",
            "warningOnly": false
          }
        }
      ]
    },
    {
      "id": "Test07-HistoryInstance",
      "name": "History Operation (Instance-level)",
      "description": "Get the history of the specific Patient resource instance (GET /Patient/[id]/_history).",
      "action": [
        {
          "operation": {
            "type": {
              "system": "http://terminology.hl7.org/CodeSystem/testscript-operation-codes",
              "code": "history"
            },
            "resource": "Patient",
            "description": "Get instance-level history for the Patient.",
            "accept": "json",
            "encodeRequestUrl": true,
            "responseId": "history-instance-response",
            "targetId": "create-response"
          }
