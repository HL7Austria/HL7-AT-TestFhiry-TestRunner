        {
          "assert": {
            "description": "Confirm the response display is 'okay'.",
            "direction": "response",
            "response": "okay",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the response content type contains JSON.",
            "contentType": "application/fhir+json",
            "warningOnly": false
          }
        },
        {
          "assert": {
            "description": "Confirm the updated Patient still has the name 'Bucher'.",
            "expression": "Patient.name.where(family = 'Bucher').exists()",
            "operator": "eval",
            "warningOnly": false
          }
        }
      ]
    },
    {
      "id": "Test05-Patch",
