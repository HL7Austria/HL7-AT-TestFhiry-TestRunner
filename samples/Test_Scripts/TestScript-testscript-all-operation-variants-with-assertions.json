            "resource": "Patient",
            "description": "Search for Patient by family name.",
            "accept": "json",
            "encodeRequestUrl": true,
            "responseId": "search-response",
            "params": "?family=Bucher"
          }
        },
        {
          "assert": {
            "description": "Confirm that the returned HTTP status is 200 (OK).",
            "direction": "response",
            "responseCode": "200",
            "warningOnly": false
